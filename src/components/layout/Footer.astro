---
import { tString } from '../../utils/i18nStatic.js'
import { externalLinks } from '../../data/links.jsx'

let lang = Astro.currentLocale ?? ''
---

<footer
  class="semibold mt-auto flex w-full flex-col items-center justify-center pb-4 pt-16 text-center align-top text-sm text-accent sm:flex-row"
>
  <div
    class="flex flex-col items-center gap-y-2 font-semibold sm:flex-row sm:gap-x-4 sm:gap-y-0"
  >
    <span>{tString(lang, 'footer_text')}</span>
    <a
      href={externalLinks.github}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="mr-2 h-5 w-5 fill-current"
        viewBox="0 0 24 24"
      >
        <path
          d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.5 7.8 11.1.6.1.8-.3.8-.6v-2.1c-3.2.7-3.9-1.3-3.9-1.3-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 .1 1.5 1 1.5 1 .9 1.5 2.3 1 2.9.8.1-.7.4-1 .7-1.2-2.6-.3-5.3-1.3-5.3-5.9 0-1.3.5-2.3 1.1-3.1-.1-.3-.5-1.5.1-3.1 0 0 .9-.3 3 .9.9-.3 1.9-.4 2.9-.4s2 .1 2.9.4c2.1-1.2 3-.9 3-.9.6 1.6.2 2.8.1 3.1.7.8 1.1 1.8 1.1 3.1 0 4.6-2.7 5.6-5.3 5.9.4.3.8 1 .8 2v3c0 .3.2.7.8.6 4.5-1.6 7.8-6 7.8-11.1C23.5 5.7 18.3.5 12 .5z"
        ></path>
      </svg>
      <span>{tString(lang, 'footer_github_text')}</span>
    </a>
  </div>
</footer>
