---
import { Icon } from "astro-icon/components"
import Navigation from '../navigation/Nav.astro'
import MobileNavigation from '../navigation/MobileNav.astro'
import LanguageSwitcher from '../navigation/LanguageSwitcher.jsx'

const { lang } = Astro.props;
---

<header
	id="main-header"
	class="fixed px-4 md:px-0 left-0 z-20 flex items-center md:relative top-0 h-16 w-full bg-bgColor md:bg-transparent overflow-hidden"
>
	<div class="w-full justify-between sm:flex-col">
		<div class="flex justify-between items-center gap-x-2">
			<a
				class="group flex h-8 items-center hover:filter-none sm:relative"
				href={`/${lang === 'sr' ? '' : lang}`}
			>
				<svg class="inline-block size-8 fill-current text-accent-base dark:text-accent-two drop-shadow-[0px_2.5px_2.5px_rgba(0,0,0,0.35)]">
					<use href="/assets/img/logo.svg"></use>
				</svg>
			</a>
			<Navigation lang={lang} />

			<div class="w-fit flex justify-between items-center gap-x-4">
				<div id="buttons-panel" class="top-4 md:top-8 flex space-x-2">
					<LanguageSwitcher lang={lang} client:only="react" />
				</div>

				<button
					aria-expanded="false"
					aria-haspopup="menu"
					aria-label="Open main menu"
					class="group relative h-8 w-8 rounded-lg bg-color-100 hover:text-accent-two/80 text-accent-two md:invisible md:hidden"
					id="toggle-nav-menu-mobile"
					type="button"
				>
					<Icon
						id="open-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-100 opacity-100 transition-all"
						focusable="false"
						name="hugeicons:menu-01"
					/>
					<Icon
						id="close-nav-menu-icon"
						aria-hidden="true"
						class="absolute start-1/2 top-1/2 h-6 w-6 -translate-x-1/2 -translate-y-1/2 scale-0 opacity-0 transition-all"
						focusable="false"
						name="hugeicons:cancel-01"
					/>
				</button>
			</div>
		</div>
	</div>
</header>

<div id="drawer" class="fixed inset-0 z-10 hidden" aria-hidden="true">
	<div
		id="drawer-body"
		class="absolute inset-0 -translate-y-full transform bg-bgColor transition-all duration-300 ease-in-out"
	>
		<MobileNavigation lang={lang} />
	</div>
</div>

<script>
	document.addEventListener("DOMContentLoaded", () => {
		const toggleBtn = document.getElementById("toggle-nav-menu-mobile");
		const openIcon = document.getElementById("open-nav-menu-icon");
		const closeIcon = document.getElementById("close-nav-menu-icon");
		const drawer = document.getElementById("drawer");
		const drawerBody = document.getElementById("drawer-body");

		if (!toggleBtn || !openIcon || !closeIcon || !drawer || !drawerBody) {
			console.error("Missing elements in DOM");
			return;
		}

		toggleBtn.addEventListener("click", () => {
			const isOpen = toggleBtn.getAttribute("aria-expanded") === "true";

			if (isOpen) {
				drawerBody.classList.add("-translate-y-full", "opacity-0");
				drawerBody.classList.remove("translate-y-0", "opacity-100");

				setTimeout(() => {
					drawer.classList.add("hidden");
				}, 300);

				openIcon.classList.remove("scale-0", "opacity-0");
				openIcon.classList.add("scale-100", "opacity-100");
				closeIcon.classList.remove("scale-100", "opacity-100");
				closeIcon.classList.add("scale-0", "opacity-0");

				toggleBtn.setAttribute("aria-expanded", "false");
			} else {
				drawer.classList.remove("hidden");

				drawerBody.classList.remove("-translate-y-full", "opacity-0");
				drawerBody.classList.add("translate-y-0", "opacity-100");

				openIcon.classList.remove("scale-100", "opacity-100");
				openIcon.classList.add("scale-0", "opacity-0");
				closeIcon.classList.remove("scale-0", "opacity-0");
				closeIcon.classList.add("scale-100", "opacity-100");

				toggleBtn.setAttribute("aria-expanded", "true");
			}
		});
	});
</script>
