---
import { getRelativeLocaleUrl } from 'astro:i18n'
import config from '../../../astro.config.mjs'
import { tObject } from '../../utils/i18nStatic'

const t = tObject(Astro.currentLocale ?? '', 'language')

const locales = config.i18n?.locales || []

const localesMap = new Map(
  locales.map((locale) => [
    locale,
    {
      name: t[locale],
      url: getRelativeLocaleUrl(locale, '/'),
    },
  ]),
)
---

<nav id="language-switcher" class="flex items-center gap-2">
  <ul class="inline-flex gap-x-4 text-sm font-medium text-accent-two">
    {
      locales
        .filter((locale) => locale !== Astro.currentLocale)
        .map((locale) => (
          <li>
            <a
              href={localesMap.get(locale)?.url || '#'}
              class="underline-offset-2 hover:underline"
            >
              {localesMap.get(locale)?.name}
            </a>
          </li>
        ))
    }
  </ul>
</nav>
