---
import { getNavLinks } from '../../utils/nav'

let lang = Astro.currentLocale ?? ''
// Normalize away a trailing slash so the active link still matches
// regardless of whether the current URL has one (e.g. a direct visit to
// "/glasanje" vs. following a nav link to "/glasanje/").
const normalizePath = (path: string) =>
  path.length > 1 ? path.replace(/\/+$/, '') : path
const currentPath = normalizePath(Astro.url.pathname)

const navLinks = getNavLinks(lang)
---

<nav
  id="main-navigation-menu"
  class="top-20 mx-auto ml-4 mr-auto hidden flex-col items-end justify-center gap-x-4 rounded-md bg-bgColor text-sm font-medium text-accent-two shadow backdrop-blur group-[.menu-open]:z-50 group-[.menu-open]:flex sm:static sm:z-auto sm:flex-row sm:items-center sm:rounded-none sm:bg-transparent sm:shadow-none sm:backdrop-blur-none md:flex"
>
  {
    navLinks.map((link) => {
      const isActive = normalizePath(link.path) === currentPath

      return (
        <a
          href={link.path}
          class={`underline-offset-2 hover:underline ${isActive ? 'underline' : ''}`}
        >
          {link.label}
        </a>
      )
    })
  }
</nav>
