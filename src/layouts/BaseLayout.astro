---
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import I18nRouterProvider from '../components/I18nRouterProvider.jsx'
import '../styles/global.css'

const { lang = 'sr', pageTitle = 'Priručnik za glasanje u inostranstvu' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body class="relative m-auto min-h-screen w-full max-w-6xl px-4 sm:px-6 lg:px-8 bg-bgColor">
		<div class="relative flex min-h-screen w-full">
			<div id="container" class="relative mx-auto w-full max-w-4xl grow">
				<div class="m-auto grid min-h-screen md:grid-rows-[auto_auto_1fr] px-4 md:px-8 md:pt-4">
					<I18nRouterProvider client:load key={lang} initialLang={lang}>
						<Header lang={lang} />
						<main id="main" class="relative flex-grow mt-32 md:mt-[3.5rem]">
							<slot />
						</main>
						<Footer lang={lang} />
					</I18nRouterProvider>
				</div>
			</div>
		</div>
	</body>
</html>
