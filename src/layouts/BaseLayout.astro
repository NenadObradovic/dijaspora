---
import Header from '../components/layout/Header.astro'
import I18nRouterProvider from '../components/I18nRouterProvider.jsx'
import '../styles/global.css'

const { lang = 'sr', pageTitle = 'Priručnik za glasanje u inostranstvu', children } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
	</head>
	<body>
		<I18nRouterProvider client:only="react" />
		<Header lang={lang} />
		<main>
			<slot />
		</main>
	</body>
</html>
