---
import Header from '../components/layout/Header.astro'
import Footer from '../components/layout/Footer.astro'
import I18nRouterProvider from '../components/I18nRouterProvider.jsx'
import '../styles/global.css'

const {
  pageTitle = 'Moja Srbija - Moj Glas',
  pageDescription = 'Glasanje iz inostranstva – jednostavno, digitalno, bezbedno',
} = Astro.props
---

<!doctype html>
<html lang={Astro.currentLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageDescription} - {pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content="/assets/img/logo.webp" />
    <meta property="og:url" content={Astro.url.toString()} />
    <meta property="og:type" content="website" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Serbia Vote" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body
    class="relative m-auto min-h-screen w-full max-w-6xl bg-bgColor px-4 sm:px-6 lg:px-8"
  >
    <div
      class="pointer-events-none fixed left-1/2 top-0 -ml-[50vw] hidden min-h-screen w-screen blur-2xl sm:block"
    >
      <div
        class="absolute right-[25%] top-[-90%] h-full w-[75%] rounded-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent opacity-40 dark:opacity-5"
      >
      </div>
      <div
        class="absolute left-[25%] top-[-90%] h-full w-[75%] rounded-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent opacity-40 dark:opacity-5"
      >
      </div>
      <div
        class="absolute right-[25%] top-[-85%] h-full w-[55%] rounded-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent opacity-40 dark:opacity-5"
      >
      </div>
      <div
        class="absolute left-[25%] top-[-85%] h-full w-[55%] rounded-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent opacity-40 dark:opacity-5"
      >
      </div>
      <div
        class="absolute left-[-25%] top-[-75%] h-full w-[65%] rounded-full bg-gradient-to-b from-blue-300 via-pink-300 to-transparent opacity-30 dark:opacity-5"
      >
      </div>
      <div
        class="absolute right-[-25%] top-[-75%] h-full w-[65%] rounded-full bg-gradient-to-b from-purple-300 via-blue-300 to-transparent opacity-30 dark:opacity-5"
      >
      </div>
      <div
        class="absolute left-[-30%] top-[-85%] h-full w-[85%] rounded-full bg-gradient-to-b from-indigo-300 via-orange-300 to-transparent opacity-60 dark:opacity-5"
      >
      </div>
      <div
        class="absolute right-[-30%] top-[-85%] h-full w-[85%] rounded-full bg-gradient-to-b from-orange-300 via-indigo-300 to-transparent opacity-60 dark:opacity-5"
      >
      </div>
    </div>
    <div class="relative flex min-h-screen w-full">
      <div id="container" class="relative mx-auto w-full max-w-4xl grow">
        <div
          class="m-auto grid min-h-screen px-4 md:grid-rows-[auto_auto_1fr] md:px-8 md:pt-4"
        >
          <I18nRouterProvider client:load initialLang={Astro.currentLocale}>
            <Header />
            <main id="main" class="relative mt-32 flex-grow md:mt-[3.5rem]">
              <slot />
            </main>
            <Footer />
          </I18nRouterProvider>
        </div>
      </div>
    </div>

    <script is:inline>
      const setupMobileMenu = () => {
        const toggleMobileButton = document.getElementById(
          'toggle-nav-menu-mobile',
        )
        const openMenuIcon = document.getElementById('open-nav-menu-icon')
        const closeMenuIcon = document.getElementById('close-nav-menu-icon')
        const drawer = document.getElementById('drawer')
        const drawerBody = document.getElementById('drawer-body')

        if (
          !toggleMobileButton ||
          !openMenuIcon ||
          !closeMenuIcon ||
          !drawer ||
          !drawerBody
        ) {
          return false // Elements not ready yet
        }

        toggleMobileButton.addEventListener('click', () => {
          const isOpen =
            toggleMobileButton.getAttribute('aria-expanded') === 'true'

          if (isOpen) {
            drawerBody.classList.add('opacity-0', '-translate-y-full')
            drawerBody.classList.remove('translate-y-0')

            setTimeout(() => {
              drawer.classList.add('hidden')
            }, 300)

            openMenuIcon.classList.add('scale-100', 'opacity-100')
            closeMenuIcon.classList.add('scale-0', 'opacity-0')
            closeMenuIcon.classList.remove('scale-100', 'opacity-100')
          } else {
            drawer.classList.remove('hidden')
            drawerBody.classList.add('translate-y-0')
            drawerBody.classList.remove('opacity-0', '-translate-y-full')

            openMenuIcon.classList.add('scale-0', 'opacity-0')
            closeMenuIcon.classList.add('scale-100', 'opacity-100')
            openMenuIcon.classList.remove('scale-100', 'opacity-100')
          }

          toggleMobileButton.setAttribute('aria-expanded', (!isOpen).toString())
        })

        return true
      }

      // Try setup immediately in case header already exists
      if (!setupMobileMenu()) {
        // Fallback to MutationObserver if Header is injected later (client:load)
        const observer = new MutationObserver((mutations, obs) => {
          if (setupMobileMenu()) {
            obs.disconnect() // Done
          }
        })

        observer.observe(document.body, {
          childList: true,
          subtree: true,
        })
      }
    </script>
  </body>
</html>
