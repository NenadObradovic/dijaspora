const pageTitle = srCyrlTranslations.page_title || 'Приручник за гласање у иностранству';
---

<BaseLayout lang="sr-cyrl" pageTitle={pageTitle}>
	<h1 class="title text-3xl bg-gradient-to-r from-accent-two/85 via-accent-one/85 to-accent-two/85 dark:from-accent-two dark:via-accent-one dark:to-accent-two bg-clip-text text-transparent">Добродошли</h1>
