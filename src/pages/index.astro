---
import BaseLayout from '../layouts/BaseLayout.astro'
import srLatinTranslations from '../locales/sr-latn/translation.json'
import { externalLinks } from '../data/links.jsx'

const pageTitle = srLatinTranslations.page_title || ''
const pageDescription = srLatinTranslations.page_description || ''
---

<BaseLayout
  lang="sr-latn"
  pageTitle={pageTitle}
  pageDescription={pageDescription}
>
  <section class="w-full">
    <h1
      class="title mt-6 bg-gradient-to-r from-accent-two/85 via-accent-one/85 to-accent-two/85 bg-clip-text text-center !text-2xl text-transparent dark:from-accent-two dark:via-accent-one dark:to-accent-two sm:mt-0 sm:text-4xl"
    >
      Glasanje iz inostranstva – jednostavno, digitalno, bezbedno
    </h1>

    <p class="mt-6">
      Aplikacija Vam pomaže da popunite podatke i generišete popunjene obrasce
      za prijavu glasanja iz inostranstva. Slanje obrasca i priloga obavljate
      Vi, direktno nadležnom diplomatsko-konzularnom predstavništvu (DKP).
      <br /><br />
      Proces koji je ranije zahtevao štampanje, skeniranje i sate traženja informacija
      sada se završava za svega nekoliko minuta. Svi podaci se obrađuju lokalno na
      Vašem računaru. Aplikacija ne šalje podatke na naše servere; dokument se generiše
      u pregledaču i preuzimate ga na svoj uređaj.
    </p>
  </section>

  <section class="mt-6 w-full">
    <h2 class="title mb-4 text-center text-xl text-accent-two">
      Važno obaveštenje
    </h2>

    <p class="mt-6">
      Ovaj sajt <strong>nije zvanični sajt državne institucije</strong>, već
      nezavisna, open-source inicijativa koja ima za cilj da pomogne građanima
      Srbije u dijaspori pri registraciji za glasanje. Sajt nije povezan sa
      Ministarstvom spoljnih poslova, RIK-om niti drugim organima Republike
      Srbije, niti predstavlja njihov zvanični kanal.
      <br /><br />
      <strong>Ne prikupljamo niti čuvamo lične podatke.</strong> Sve informacije se
      obrađuju <strong>lokalno</strong> na Vašem uređaju – ne šalju se na naše servere.
      <br /><br />
      Korišćenje ovog sajta <strong>nije obavezno</strong>. Formular možete
      popuniti i ručno. Detaljna uputstva za to možete pronaći na <a
        href={externalLinks.mfa}
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent-two underline-offset-2 hover:underline"
        >zvaničnom sajtu Ministarstva spoljnih poslova</a
      > ili zatražiti u najbližoj ambasadi ili konzulatu.
      <br /><br />
      Naša misija je da Vam pružimo jednostavniji i bezbedan način da ostvarite svoje
      biračko pravo – uz potpunu kontrolu i transparentnost. Vaš glas može biti ključan
      – iskoristite ga.
    </p>
  </section>

  <section class="mt-12 w-full">
    <div class="mt-10 flex items-center justify-center gap-6">
      <a
        href={srLatinTranslations.header_nav.handbook_path}
        class="rounded-lg bg-accent-two px-6 py-3 text-sm font-semibold text-white shadow-md transition duration-200 hover:bg-accent-two/90"
      >
        Saznajte više
      </a>
      <a
        href={srLatinTranslations.header_nav.form_path}
        class="rounded-lg border border-accent-two px-6 py-3 text-sm font-semibold text-accent-two transition duration-200 hover:bg-accent-two hover:text-white"
      >
        Popunite zahtev
      </a>
    </div>
  </section>
</BaseLayout>
